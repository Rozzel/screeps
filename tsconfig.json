{
  "compilerOptions": {
    "module": "esnext",
    "lib": ["es2018"],
    "target": "es2017",
    "moduleResolution": "bundler",
    "rootDir": "src",
    "outDir": "dist",
    "paths": {
      "config/*": ["./src/config/*"],
      "creeps/*": ["./src/creeps/*"],
      "managers/*": ["./src/managers/*"],
      "memory/*": ["./src/memory/*"],
      "spawning/*": ["./src/spawning/*"],
      "types/*": ["./src/types/*"],
      "utils/*": ["./src/utils/*"]
    },
    "typeRoots": ["./vendor/@types", "./node_modules/@types"],
    "types": ["screeps"],
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "noImplicitReturns": true,
    "allowSyntheticDefaultImports": true,
    "allowUnreachableCode": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
